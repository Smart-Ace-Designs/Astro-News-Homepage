---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/*.{jpeg,jpg,png,gif}");
const web3Desktop = images["/src/assets/image-web-3-desktop.jpg"]?.();
const web3Mobile = images["/src/assets/image-web-3-mobile.jpg"]?.();
---

<article class="mb-8 sm:mb-0">
  {
    web3Desktop && (
      <Image
        src={web3Desktop}
        alt="Web 3.0"
        class="hidden sm:block"
        loading="eager"
        format="webp"
      />
    )
  }
  {
    web3Mobile && (
      <Image src={web3Mobile} alt="Web 3.0" class="block sm:hidden" loading="eager" format="webp" />
    )
  }
  <div class="mt-8 flex flex-col gap-x-8 gap-y-4 lg:flex-row">
    <div class="w-full lg:w-1/2">
      <h1 class="text-[2.5rem] leading-none font-extrabold text-theme-very-dark-blue lg:text-6xl">
        The Bright Future of Web 3.0?
      </h1>
    </div>
    <div class="flex flex-1 flex-col justify-between gap-y-4">
      <p class="leading-6 text-theme-dark-grayish-blue">
        We dive into the next evolution of the web that claims to put the power of the platforms
        back into the hands of the people. But is it really fulfilling its promise?
      </p>
      <a
        href={import.meta.env.BASE_URL}
        class="w-1/2 bg-theme-soft-red px-6 py-3 text-center font-bold tracking-[0.2em] text-theme-very-dark-blue uppercase transition-colors delay-100 hover:bg-theme-very-dark-blue hover:text-theme-off-white sm:w-1/3 lg:w-1/2"
        >Read more</a
      >
    </div>
  </div>
</article>
